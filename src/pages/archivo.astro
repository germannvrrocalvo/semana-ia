---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Migas from '../components/Migas.astro';
import { fechaLarga, tituloSeccion } from '../lib/secciones';

const ediciones = (await getCollection('ediciones')).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf(),
);

// Agrupadas por ano para que el archivo siga siendo navegable dentro de tres anos.
const porAno = [
  ...ediciones.reduce((mapa, e) => {
    const ano = e.data.fecha.getUTCFullYear();
    mapa.set(ano, [...(mapa.get(ano) ?? []), e]);
    return mapa;
  }, new Map<number, typeof ediciones>()),
].sort((a, b) => b[0] - a[0]);

const totalNoticias = ediciones.reduce((n, e) => n + e.data.entradas.length, 0);
const medios = new Set(ediciones.flatMap((e) => e.data.entradas.map((x) => x.fuente))).size;

const migas = [{ nombre: 'Inicio', href: '/' }, { nombre: 'Archivo' }];
---

<Base
  titulo="Archivo"
  descripcion="Todas las ediciones semanales de Semana IA, de la más reciente a la primera."
  migas={migas}
>
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <Migas migas={migas} />

    <header class="mt-10 border-b-2 border-[var(--color-tinta)] pb-10">
      <h1 class="titular-portada">El archivo completo</h1>
      <p class="meta mt-6 text-sm text-[var(--color-apunte)]">
        {ediciones.length}
        {ediciones.length === 1 ? 'edición publicada' : 'ediciones publicadas'}, {totalNoticias}
        noticias recopiladas y {medios}
        {medios === 1 ? 'medio citado' : 'medios citados'}.
      </p>
    </header>

    {
      porAno.map(([ano, lista]) => (
        <section class="entra mt-14">
          <h2 class="filete-seccion meta text-sm tracking-[0.14em] uppercase">{ano}</h2>

          {/*
            Cada edicion es una ficha: numero, fecha, titular de la semana, sus
            ejes y cuanto trae dentro. Con el listado anterior (fecha y titular en
            una linea) no habia forma de decidir cual abrir.
          */}
          <ul class="mt-8 grid gap-6 md:grid-cols-2">
            {lista.map((e) => (
              <li class="grupo-titular">
                <a
                  href={`/ediciones/${e.data.semana}`}
                  class="flex h-full flex-col border border-[var(--color-linea)] p-7 no-underline transition-colors hover:border-[var(--color-tinta)]"
                >
                  <div class="meta flex items-baseline justify-between gap-4 text-xs">
                    <span class="tracking-[0.14em] text-[var(--color-senal)] uppercase">
                      Edición {e.data.semana.split('-W')[1]}
                    </span>
                    <span class="text-[var(--color-apunte)]">{fechaLarga(e.data.fecha)}</span>
                  </div>

                  <p class="enlace-titular mt-5 text-xl leading-snug font-medium sm:text-2xl">
                    {e.data.destacado}
                  </p>

                  {e.data.temas.length > 0 && (
                    <ul class="meta mt-5 flex flex-wrap gap-2 text-xs text-[var(--color-apunte)]">
                      {e.data.temas.slice(0, 4).map((tema) => (
                        <li class="border border-[var(--color-linea)] px-2 py-0.5">
                          {tituloSeccion(tema)}
                        </li>
                      ))}
                    </ul>
                  )}

                  <div class="meta mt-auto flex items-baseline justify-between gap-4 pt-7 text-xs">
                    <span class="text-[var(--color-apunte)]">
                      {e.data.entradas.length} noticias
                    </span>
                    <span class="text-[var(--color-senal)]">Leer la edición</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    {
      ediciones.length === 0 && (
        <p class="mt-12 max-w-[52ch] leading-relaxed text-[var(--color-apunte)]">
          El archivo se llenará en cuanto se publique la primera edición.
        </p>
      )
    }
  </div>
</Base>
