---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import { fechaLarga } from '../../lib/secciones';

export const getStaticPaths = (async () => {
  const piezas = await getCollection('analisis', ({ data }) => !data.borrador);
  return piezas.map((pieza) => ({ params: { slug: pieza.id }, props: { pieza } }));
}) satisfies GetStaticPaths;

const { pieza } = Astro.props;
const { Content } = await render(pieza);

const migas = [
  { nombre: 'Inicio', href: '/' },
  { nombre: 'Análisis', href: '/analisis' },
  { nombre: pieza.data.titulo },
];
---

{/*
  Una pieza de fondo es el unico contenido del sitio que es enteramente propio, y
  se compone como tal: columna de lectura, firma y fecha visibles, y su ficha de
  Article completa para los buscadores.
*/}
<Base
  titulo={pieza.data.titulo}
  descripcion={pieza.data.descripcion}
  migas={migas}
  articulo={{
    titulo: pieza.data.titulo,
    fecha: pieza.data.fecha,
    modificada: pieza.data.actualizada,
    firma: pieza.data.firma,
  }}
>
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <Migas migas={migas} />

    <article class="mt-10">
      <header class="border-b border-[var(--color-linea)] pb-10">
        <h1 class="titular-portada">{pieza.data.titulo}</h1>

        <p class="mt-8 max-w-[62ch] text-lg leading-relaxed text-[var(--color-apunte)]">
          {pieza.data.descripcion}
        </p>

        <p class="meta mt-8 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-[var(--color-apunte)]">
          <span class="text-[var(--color-tinta)]">{pieza.data.firma}</span>
          <time datetime={pieza.data.fecha.toISOString()}>{fechaLarga(pieza.data.fecha)}</time>
          {
            pieza.data.actualizada && (
              <span>
                Revisada el{' '}
                <time datetime={pieza.data.actualizada.toISOString()}>
                  {fechaLarga(pieza.data.actualizada)}
                </time>
              </span>
            )
          }
        </p>
      </header>

      <div
        class="mt-12 max-w-[68ch] text-lg leading-relaxed [&_a]:text-[var(--color-senal)] [&_a]:underline [&_a]:underline-offset-4 [&_blockquote]:my-8 [&_blockquote]:border-l-2 [&_blockquote]:border-[var(--color-senal)] [&_blockquote]:pl-5 [&_blockquote]:text-[var(--color-apunte)] [&_code]:font-mono [&_code]:text-base [&_h2]:mt-14 [&_h2]:text-2xl [&_h2]:tracking-tight [&_h3]:mt-10 [&_h3]:text-xl [&_li]:mt-2.5 [&_ol]:mt-5 [&_ol]:list-outside [&_ol]:list-decimal [&_ol]:pl-5 [&_p]:mt-5 [&_strong]:font-medium [&_ul]:mt-5 [&_ul]:list-outside [&_ul]:list-disc [&_ul]:pl-5"
      >
        <Content />
      </div>

      <footer class="mt-16 border-t border-[var(--color-linea)] pt-8">
        <a
          href="/analisis"
          class="meta text-sm text-[var(--color-senal)] underline-offset-4 hover:underline"
        >
          Ver las demás piezas
        </a>
      </footer>
    </article>
  </div>
</Base>
