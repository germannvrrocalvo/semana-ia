---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { aSlug } from '../../lib/secciones';

const ediciones = await getCollection('ediciones');

const recuento = new Map<string, { etiqueta: string; total: number }>();
for (const e of ediciones) {
  for (const tema of e.data.temas) {
    const slug = aSlug(tema);
    if (!slug) continue;
    const previo = recuento.get(slug);
    recuento.set(slug, { etiqueta: previo?.etiqueta ?? tema, total: (previo?.total ?? 0) + 1 });
  }
}

const temas = [...recuento].sort((a, b) => b[1].total - a[1].total || a[0].localeCompare(b[0]));
---

<Base
  titulo="Temas"
  descripcion="Los ejes que se repiten semana tras semana en las noticias de inteligencia artificial."
>
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
    <header class="border-b-2 border-[var(--color-tinta)] pb-10">
      <h1 class="titular-portada">Seguir un tema en el tiempo</h1>
      <p class="mt-6 max-w-[62ch] leading-relaxed text-[var(--color-apunte)]">
        Cada edición se etiqueta con los ejes que la han dominado. Son siempre los mismos seis, para
        que comparar una semana con otra signifique algo.
      </p>
    </header>

    {
      temas.length > 0 ? (
        <ul class="mt-4">
          {temas.map(([slug, { etiqueta, total }]) => (
            <li class="grupo-titular border-b border-[var(--color-linea)]">
              <a
                href={`/temas/${slug}`}
                class="flex items-baseline justify-between gap-6 py-7 no-underline"
              >
                <span class="enlace-titular text-2xl leading-snug font-medium sm:text-3xl">
                  {etiqueta}
                </span>
                <span class="meta shrink-0 text-xs text-[var(--color-apunte)]">
                  {total} {total === 1 ? 'edición' : 'ediciones'}
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-12 max-w-[52ch] leading-relaxed text-[var(--color-apunte)]">
          Todavía no hay temas: aparecerán en cuanto se publique la primera edición.
        </p>
      )
    }
  </div>
</Base>
