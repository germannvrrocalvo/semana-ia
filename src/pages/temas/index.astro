---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import { aSlug, fechaLarga, tituloSeccion } from '../../lib/secciones';

const ediciones = await getCollection('ediciones');

/*
  Cada tema se cuenta con tres datos que salen del contenido publicado: en cuantas
  ediciones ha aparecido, cuantas noticias lleva acumuladas y cuando fue la ultima
  vez. Ninguno se estima: son recuentos sobre los archivos de las ediciones.
*/
const recuento = new Map<
  string,
  { etiqueta: string; ediciones: number; noticias: number; ultima: Date }
>();

for (const e of ediciones) {
  for (const tema of e.data.temas) {
    const slug = aSlug(tema);
    if (!slug) continue;
    const previo = recuento.get(slug);
    const noticias = e.data.entradas.filter((x) => x.seccion === tema).length;
    recuento.set(slug, {
      etiqueta: previo?.etiqueta ?? tituloSeccion(tema),
      ediciones: (previo?.ediciones ?? 0) + 1,
      noticias: (previo?.noticias ?? 0) + noticias,
      ultima:
        previo && previo.ultima > e.data.fecha ? previo.ultima : e.data.fecha,
    });
  }
}

const temas = [...recuento].sort(
  (a, b) => b[1].noticias - a[1].noticias || a[0].localeCompare(b[0]),
);

const migas = [{ nombre: 'Inicio', href: '/' }, { nombre: 'Temas' }];
---

<Base
  titulo="Temas"
  descripcion="Los ejes que se repiten semana tras semana en las noticias de inteligencia artificial: modelos, producto, investigación, negocio, regulación y código abierto."
  migas={migas}
>
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <Migas migas={migas} />

    <header class="mt-10 border-b-2 border-[var(--color-tinta)] pb-10">
      <h1 class="titular-portada">Seguir un tema en el tiempo</h1>
      <p class="mt-6 max-w-[62ch] leading-relaxed text-[var(--color-apunte)]">
        Cada noticia se clasifica en uno de estos ejes y cada edición se etiqueta con los que la
        han dominado. Son siempre los mismos, de forma que comparar una semana con otra signifique
        algo.
      </p>
    </header>

    {
      temas.length > 0 ? (
        <ul class="mt-2">
          {temas.map(([slug, datos]) => (
            <li class="grupo-titular border-b border-[var(--color-linea)]">
              <a
                href={`/temas/${slug}`}
                class="grid items-baseline gap-x-8 gap-y-3 py-8 no-underline md:grid-cols-[1fr_auto]"
              >
                <div>
                  <span class="enlace-titular text-2xl leading-snug font-medium sm:text-3xl">
                    {datos.etiqueta}
                  </span>
                  <span class="meta mt-2 block text-xs text-[var(--color-apunte)]">
                    Última aparición: {fechaLarga(datos.ultima)}
                  </span>
                </div>

                <dl class="meta flex gap-8 text-xs md:justify-end">
                  <div>
                    <dt class="text-[var(--color-apunte)]">Noticias</dt>
                    <dd class="mt-1 text-lg text-[var(--color-tinta)]">{datos.noticias}</dd>
                  </div>
                  <div>
                    <dt class="text-[var(--color-apunte)]">Ediciones</dt>
                    <dd class="mt-1 text-lg text-[var(--color-tinta)]">{datos.ediciones}</dd>
                  </div>
                </dl>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-12 max-w-[52ch] leading-relaxed text-[var(--color-apunte)]">
          Todavía no hay temas: aparecerán en cuanto se publique la primera edición.
        </p>
      )
    }
  </div>
</Base>
