---
export interface Miga {
  nombre: string;
  /** La ultima miga es la pagina actual y no lleva enlace. */
  href?: string;
}

interface Props {
  migas: Miga[];
}

const { migas } = Astro.props;
---

{/*
  Ruta de navegacion. Existe por dos motivos a la vez: le dice al lector donde
  esta cuando ha entrado desde un buscador directamente a una edicion de hace
  cuatro meses, y alimenta el BreadcrumbList que emite el layout.
*/}
<nav aria-label="Ruta" class="meta text-xs text-[var(--color-apunte)]">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {
      migas.map((miga, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true">/</span>}
          {miga.href ? (
            <a href={miga.href} class="no-underline hover:text-[var(--color-senal)]">
              {miga.nombre}
            </a>
          ) : (
            <span aria-current="page">{miga.nombre}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
