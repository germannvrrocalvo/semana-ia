---
import type { CollectionEntry } from 'astro:content';
import { agruparPorSeccion, fechaCorta } from '../lib/secciones';
import { marcaDe } from '../lib/marcas';
import Marca from './Marca.astro';
import PorQueImporta from './PorQueImporta.astro';
import Anuncio from './Anuncio.astro';

interface Props {
  edicion: CollectionEntry<'ediciones'>;
  /** La portada usa h1 para el titular de la semana; el archivo, h2. */
  nivel?: 'h1' | 'h2';
}

const { edicion, nivel = 'h1' } = Astro.props;
const { data } = edicion;
const Titulo = nivel;

/*
  Jerarquia de la edicion. El robot entrega las entradas ya ordenadas por
  relevancia, asi que el orden del archivo es el orden editorial:

    la primera           -> la noticia que abre, a ancho completo
    las cinco siguientes -> portada: la primera a doble ancho, las otras cuatro debajo
    el resto             -> cuerpo, agrupado por seccion

  Cada noticia aparece una sola vez y siempre con su resumen. Si la edicion trae
  pocas entradas los cortes se quedan vacios y las secciones desaparecen solas.
*/
const [apertura, ...restantes] = data.entradas;
const portada = restantes.slice(0, 5);
const cuerpo = agruparPorSeccion(restantes.slice(5));

/*
  El titular de portada. Si la edicion trae titularCorto, ese es el bueno: se pide
  al redactor de setenta caracteres para abajo justamente para poder ponerlo a
  cuerpo de cartel. Las ediciones anteriores al campo caen en el destacado, que es
  una frase entera, y entonces el cuerpo se elige por longitud: sin esto, un
  titular de 130 caracteres a 76px se come la primera pantalla en seis lineas.
*/
const titular = data.titularCorto ?? data.destacado;
const tamanoTitular =
  data.titularCorto || titular.length <= 58
    ? 'titular-portada--corto'
    : titular.length > 95
      ? 'titular-portada--largo'
      : '';

const medios = new Set(data.entradas.map((e) => e.fuente)).size;
const numeroSemana = data.semana.split('-W')[1];

/* "Semana del 7-13 de septiembre de 2026" se queda en "7-13 de septiembre de 2026". */
const rangoSemana = data.titulo.replace(/^Semana del\s+/i, '');

/* Los datos de cabecera de la edicion, en la banda tecnica de arriba. */
const folio: [string, string][] = [
  ['Edición', `Número ${numeroSemana}`],
  ['Semana', rangoSemana],
  ['Noticias', `${data.entradas.length} de ${medios} medios`],
  ['Fuentes rastreadas', String(data.fuentesConsultadas ?? 19)],
];
---

<article>
  {/*
    Los datos de la edicion van arriba, en una banda de celdas separadas por
    filete. Dicen de que semana se habla y con cuanto material antes de que el
    lector lea nada, y de paso liberan al titular para que ocupe el ancho entero.
  */}
  <dl
    class="banda-datos meta asoma grid grid-cols-2 gap-px bg-[var(--color-linea)] text-xs sm:grid-cols-4"
  >
    {
      folio.map(([clave, valor]) => (
        <div class="bg-[var(--color-papel)] py-4 pr-4">
          <dt class="tracking-[0.14em] text-[var(--color-apunte)] uppercase">{clave}</dt>
          <dd class="mt-1.5 text-sm text-[var(--color-tinta)]">{valor}</dd>
        </div>
      ))
    }
  </dl>

  <section class="pt-14 sm:pt-20">
    {/* Sin animacion de entrada a proposito: es el elemento que mide el LCP y
        arrancarlo desde opacity 0 retrasa la medida sin ganar nada. */}
    <Titulo class:list={['titular-portada', tamanoTitular]}>{titular}</Titulo>

    {
      Astro.slots.has('default') && (
        <div
          class="asoma mt-10 max-w-[92ch] text-lg leading-relaxed text-[var(--color-apunte)] md:columns-2 md:gap-12 [&_p+p]:mt-4"
          style="--turno: 1"
        >
          <slot />
        </div>
      )
    }

    {
      data.etiquetas.length > 0 && (
        <ul
          class="meta asoma mt-10 flex flex-wrap gap-2 text-xs text-[var(--color-apunte)]"
          style="--turno: 2"
        >
          {data.etiquetas.map((etiqueta) => (
            <li class="border border-[var(--color-linea)] px-2.5 py-1">{etiqueta}</li>
          ))}
        </ul>
      )
    }
  </section>

  {/* La noticia que abre, a ancho completo: titular a la izquierda y su lectura a
      la derecha. Es el segundo momento visual de la pagina; antes iba apretada en
      una columna estrecha al lado del titular. */}
  {
    apertura && (
      <section class="grupo-titular entra mt-20 border-t border-[var(--color-linea)] pt-10">
        {/* No dice "la mas importante": el orden lo fija el recuento de relevancia,
            y el titular de la semana lo escribe el redactor leyendo todas. Que la
            primera de la lista no sea siempre la misma historia es normal. */}
        <p class="meta text-xs tracking-[0.2em] text-[var(--color-senal)] uppercase">
          Abre la edición
        </p>

        <div class="mt-8 grid gap-x-12 gap-y-8 lg:grid-cols-12">
          <h2 class="titular-seccion lg:col-span-7">
            <a
              href={apertura.url}
              rel="noopener noreferrer external"
              target="_blank"
              title={apertura.tituloOriginal}
              class="enlace-titular no-underline"
            >
              {apertura.titulo}
            </a>
          </h2>

          <div class="lg:col-span-5">
            {apertura.resumen && (
              <p class="leading-relaxed text-[var(--color-apunte)]">{apertura.resumen}</p>
            )}

            <PorQueImporta texto={apertura.porQueImporta} />

            <p class="meta mt-5 flex items-center gap-2.5 text-xs text-[var(--color-apunte)]">
              <Marca marca={marcaDe(apertura.fuente)} lado={22} />
              <span class="text-[var(--color-tinta)]">{apertura.fuente}</span>
              <time datetime={apertura.fecha.toISOString()}>{fechaCorta(apertura.fecha)}</time>
            </p>
          </div>
        </div>
      </section>
    )
  }

  {/* Portada. La primera noticia ocupa dos columnas y va mas grande: cinco
      entradas llenan exactamente dos filas, sin celdas sueltas al final. */}
  {
    portada.length > 0 && (
      <section class="entra mt-20">
        <h2 class="sr-only">Portada</h2>

        <div class="grid gap-x-10 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
          {portada.map((entrada, i) => (
            <div class:list={['grupo-titular', i === 0 && 'md:col-span-2']}>
              <p class="meta flex items-center gap-2.5 text-xs text-[var(--color-apunte)]">
                <Marca marca={marcaDe(entrada.fuente)} lado={20} />
                <span class="text-[var(--color-tinta)]">{entrada.fuente}</span>
                <time datetime={entrada.fecha.toISOString()}>{fechaCorta(entrada.fecha)}</time>
              </p>

              <h3
                class:list={[
                  'mt-3 leading-snug',
                  i === 0 ? 'text-2xl sm:text-[1.75rem]' : 'text-xl',
                ]}
              >
                <a
                  href={entrada.url}
                  rel="noopener noreferrer external"
                  target="_blank"
                  title={entrada.tituloOriginal}
                  class="enlace-titular no-underline"
                >
                  {entrada.titulo}
                </a>
              </h3>

              {entrada.resumen && (
                <p
                  class:list={[
                    'mt-3 leading-relaxed text-[var(--color-apunte)]',
                    i === 0 && 'max-w-[62ch] text-lg',
                  ]}
                >
                  {entrada.resumen}
                </p>
              )}

              <PorQueImporta texto={entrada.porQueImporta} />

              {entrada.tambienEn.length > 0 && (
                <p class="meta mt-3 text-xs text-[var(--color-apunte)]">
                  También en {entrada.tambienEn.join(', ')}
                </p>
              )}
            </div>
          ))}
        </div>
      </section>
    )
  }

  <Anuncio posicion="en-edicion" />

  {/* Cuerpo por secciones. La cabecera de seccion lleva filete de acento encima,
      que es lo que marca el cambio de bloque cuando la edicion se hace larga. */}
  {
    cuerpo.map((seccion) => (
      <section class="entra mt-20">
        <h2 class="filete-seccion meta text-sm tracking-[0.14em] uppercase">{seccion.titulo}</h2>

        <div class="mt-8 grid gap-x-10 gap-y-9 md:grid-cols-2">
          {seccion.entradas.map((entrada) => (
            <div class="grupo-titular border-t border-[var(--color-linea)] pt-6">
              <h3 class="text-lg leading-snug">
                <a
                  href={entrada.url}
                  rel="noopener noreferrer external"
                  target="_blank"
                  title={entrada.tituloOriginal}
                  class="enlace-titular no-underline"
                >
                  {entrada.titulo}
                </a>
              </h3>

              {entrada.resumen && (
                <p class="mt-2.5 leading-relaxed text-[var(--color-apunte)]">{entrada.resumen}</p>
              )}

              <p class="meta mt-3 flex items-center gap-2.5 text-xs text-[var(--color-apunte)]">
                <Marca marca={marcaDe(entrada.fuente)} lado={18} />
                <span class="text-[var(--color-tinta)]">{entrada.fuente}</span>
                <time datetime={entrada.fecha.toISOString()}>{fechaCorta(entrada.fecha)}</time>
              </p>
            </div>
          ))}
        </div>
      </section>
    ))
  }
</article>
