---
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { SITIO } from '../lib/sitio';

import type { Miga } from '../components/Migas.astro';

interface Props {
  titulo: string;
  descripcion: string;
  /** Marca la portada para que los buscadores no la traten como duplicado de la ultima edicion. */
  canonica?: string;
  /** Mismas migas que pinta el componente Migas: aqui salen como BreadcrumbList. */
  migas?: Miga[];
  /** Solo en las paginas de edicion: su ficha de Article para los buscadores. */
  articulo?: { titulo: string; fecha: Date; seccion?: string };
  /** Para paginas sin contenido propio, como los resultados de busqueda. */
  noIndexar?: boolean;
}

const { titulo, descripcion, canonica, migas, articulo, noIndexar } = Astro.props;
const url = new URL(canonica ?? Astro.url.pathname, Astro.site);
const tituloCompleto = titulo === SITIO.nombre ? titulo : `${titulo} · ${SITIO.nombre}`;

/*
  El identificador de AdSense llega por variable de entorno. Mientras este vacio,
  la pagina no carga ni un solo script de terceros: es lo que permite pedir la
  revision con el sitio limpio y encender la publicidad despues sin tocar codigo.
*/
const adsense = import.meta.env.PUBLIC_ADSENSE_CLIENT?.trim();

/*
  Datos estructurados. El sitio y el editor van en todas las paginas; las migas y
  la ficha de Article solo donde existen de verdad. Ningun campo se rellena con
  un valor inventado: si no hay dato, la propiedad no se emite.
*/
const datosEstructurados = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITIO.url}/#sitio`,
      url: SITIO.url,
      name: SITIO.nombre,
      description: SITIO.descripcion,
      inLanguage: 'es-ES',
      publisher: { '@id': `${SITIO.url}/#editor` },
    },
    {
      '@type': 'Organization',
      '@id': `${SITIO.url}/#editor`,
      name: SITIO.nombre,
      url: SITIO.url,
      email: SITIO.correo,
      founder: SITIO.responsable,
      foundingDate: String(SITIO.desde),
    },
    ...(migas && migas.length > 1
      ? [
          {
            '@type': 'BreadcrumbList',
            itemListElement: migas.map((miga, i) => ({
              '@type': 'ListItem',
              position: i + 1,
              name: miga.nombre,
              ...(miga.href ? { item: new URL(miga.href, Astro.site).href } : {}),
            })),
          },
        ]
      : []),
    ...(articulo
      ? [
          {
            // Article y no NewsArticle: una edicion es una recopilacion comentada
            // de noticias ajenas, no una pieza informativa propia. Decir lo
            // contrario seria pedirle a Google que la trate como lo que no es.
            '@type': 'Article',
            '@id': `${url.href}#edicion`,
            headline: articulo.titulo,
            description: descripcion,
            datePublished: articulo.fecha.toISOString(),
            dateModified: articulo.fecha.toISOString(),
            inLanguage: 'es-ES',
            isAccessibleForFree: true,
            mainEntityOfPage: url.href,
            author: { '@id': `${SITIO.url}/#editor` },
            publisher: { '@id': `${SITIO.url}/#editor` },
            isPartOf: { '@id': `${SITIO.url}/#sitio` },
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={url} />
    {/* Una pagina de resultados no aporta contenido propio al indice, pero sus
        enlaces si valen: noindex, follow. */}
    {noIndexar && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={articulo ? 'article' : 'website'} />
    {articulo && <meta property="article:published_time" content={articulo.fecha.toISOString()} />}
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="es_ES" />
    {/* Una sola imagen para todo el sitio, con la cabecera de la publicacion.
        Se genera con `npm run og` y se versiona: hacerla por edicion exigiria
        rasterizar tipografias en el runner de CI, donde no estan instaladas. */}
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITIO.nombre}: cada lunes, lo que ha pasado en inteligencia artificial`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site).href} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITIO.nombre} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(datosEstructurados)}
    />

    <meta name="theme-color" content="#0e0f11" />

    <script is:inline>
      // El sitio es oscuro por defecto, asi que el CSS ya trae el tema oscuro en
      // :root y aqui solo hay que marcar la excepcion. Se ejecuta antes de pintar
      // para que quien haya elegido el tema claro no vea un fogonazo oscuro.
      (() => {
        try {
          if (localStorage.getItem('tema') === 'claro') {
            document.documentElement.dataset.tema = 'claro';
            document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#fbfbfa');
          }
        } catch {
          /* Modo privado sin acceso a localStorage: se queda con el tema oscuro. */
        }
      })();
    </script>

    {
      adsense && (
        <>
          {/*
            Modo de consentimiento v2. Se declara denegado antes de cargar nada de
            Google: hasta que el aviso de cookies lo actualice, no puede haber
            publicidad personalizada. Sin esta linea la plataforma de consentimiento
            de AdSense no tiene sobre que actuar.
          */}
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('consent', 'default', {
              ad_storage: 'denied',
              ad_user_data: 'denied',
              ad_personalization: 'denied',
              analytics_storage: 'denied',
              wait_for_update: 500,
            });
          </script>

          <script
            async
            src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsense}`}
            crossorigin="anonymous"
          />
        </>
      )
    }
  </head>

  <body class="flex min-h-[100dvh] flex-col">
    <a
      href="#contenido"
      class="meta sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-[var(--color-tinta)] focus:px-4 focus:py-2 focus:text-sm focus:text-[var(--color-papel)]"
    >
      Saltar al contenido
    </a>

    <Cabecera />

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <Pie />
  </body>
</html>
