---
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { SITIO } from '../lib/sitio';

interface Props {
  titulo: string;
  descripcion: string;
  /** Marca la portada para que los buscadores no la traten como duplicado de la ultima edicion. */
  canonica?: string;
}

const { titulo, descripcion, canonica } = Astro.props;
const url = new URL(canonica ?? Astro.url.pathname, Astro.site);
const tituloCompleto = titulo === SITIO.nombre ? titulo : `${titulo} · ${SITIO.nombre}`;

/*
  El identificador de AdSense llega por variable de entorno. Mientras este vacio,
  la pagina no carga ni un solo script de terceros: es lo que permite pedir la
  revision con el sitio limpio y encender la publicidad despues sin tocar codigo.
*/
const adsense = import.meta.env.PUBLIC_ADSENSE_CLIENT?.trim();

const datosEstructurados = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITIO.url}/#sitio`,
      url: SITIO.url,
      name: SITIO.nombre,
      description: SITIO.descripcion,
      inLanguage: 'es-ES',
      publisher: { '@id': `${SITIO.url}/#editor` },
    },
    {
      '@type': 'Organization',
      '@id': `${SITIO.url}/#editor`,
      name: SITIO.nombre,
      url: SITIO.url,
      email: SITIO.correo,
      founder: SITIO.responsable,
      foundingDate: String(SITIO.desde),
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={url} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITIO.nombre} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(datosEstructurados)}
    />

    <script is:inline>
      // Se ejecuta antes de pintar para que no haya un fogonazo blanco al cargar
      // con el tema oscuro activo.
      (() => {
        try {
          const guardado = localStorage.getItem('tema');
          const oscuro = guardado
            ? guardado === 'oscuro'
            : matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.tema = oscuro ? 'oscuro' : 'claro';
        } catch {
          /* Modo privado sin acceso a localStorage: se queda con el tema por defecto. */
        }
      })();
    </script>

    {
      adsense && (
        <>
          {/*
            Modo de consentimiento v2. Se declara denegado antes de cargar nada de
            Google: hasta que el aviso de cookies lo actualice, no puede haber
            publicidad personalizada. Sin esta linea la plataforma de consentimiento
            de AdSense no tiene sobre que actuar.
          */}
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('consent', 'default', {
              ad_storage: 'denied',
              ad_user_data: 'denied',
              ad_personalization: 'denied',
              analytics_storage: 'denied',
              wait_for_update: 500,
            });
          </script>

          <script
            async
            src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsense}`}
            crossorigin="anonymous"
          />
        </>
      )
    }
  </head>

  <body class="flex min-h-[100dvh] flex-col">
    <a
      href="#contenido"
      class="meta sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-[var(--color-tinta)] focus:px-4 focus:py-2 focus:text-sm focus:text-[var(--color-papel)]"
    >
      Saltar al contenido
    </a>

    <Cabecera />

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <Pie />
  </body>
</html>
