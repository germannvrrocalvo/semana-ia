# Semana IA, configuracion de Apache.
#
# Este archivo hace en IONOS lo que hacia vercel.json: la redireccion permanente,
# las cabeceras de seguridad, la pagina de error y el cacheado. Vive en public/,
# asi que Astro lo copia tal cual a la raiz del sitio en cada compilacion.
#
# Si algo de aqui no funciona, casi siempre es que el modulo correspondiente no
# esta activo en el plan. Por eso cada bloque va dentro de su <IfModule>: lo que
# no exista se ignora en lugar de tumbar el sitio con un error 500.

# Nadie tiene por que ver el listado de una carpeta sin index.
Options -Indexes
DirectoryIndex index.html

# La pagina "Acerca de" paso a llamarse "Metodo". Redireccion permanente para no
# perder lo que ya estuviera enlazado o indexado.
RedirectMatch 301 ^/acerca-de/?$ /metodo/

# Herencia de Campus IA, que ocupaba este dominio antes. Sus direcciones estaban
# indexadas, asi que se mandan a lo mas parecido que hay ahora en lugar de
# dejarlas en 404. Las paginas de contenido no tienen equivalente y van a la
# portada, que es lo correcto cuando no hay destino mejor.
Redirect 301 /privacidad.html /privacidad/
Redirect 301 /cookies.html /cookies/
Redirect 301 /aviso-legal.html /aviso-legal/
Redirect 301 /condiciones.html /aviso-legal/
Redirect 301 /contacto.html /contacto/
Redirect 301 /quienes-somos.html /metodo/
Redirect 301 /sobre-nosotros.html /metodo/
Redirect 301 /foro.html /
Redirect 301 /mejores-ias-2026.html /
Redirect 301 /noticia-ia-espana.html /
Redirect 301 /soberania-digital.html /
# (?i) porque una de ellas se subio como .HTML en mayusculas.
RedirectMatch 301 (?i)^/ia-[a-z]+\.html$ /

# Astro genera esta pagina en la raiz.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Los archivos de _astro llevan huella en el nombre: si cambia el contenido,
  # cambia el nombre. Se pueden cachear para siempre sin miedo.
  <FilesMatch "\.(js|css|woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # El HTML no: tiene que poder cambiar cada lunes.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml image/svg+xml
</IfModule>

# El feed y el indice de busqueda necesitan su tipo correcto para que los lectores
# de RSS y el navegador no se lien.
<IfModule mod_mime.c>
  AddType application/rss+xml .xml
  AddType application/json .json
  AddCharset UTF-8 .html .css .js .json .xml .txt
</IfModule>

# HTTPS obligatorio. DESCOMENTAR SOLO CUANDO EL CERTIFICADO ESTE ACTIVO en el
# panel de IONOS: si se fuerza antes, el sitio queda inaccesible.
#<IfModule mod_rewrite.c>
#  RewriteEngine On
#  RewriteCond %{HTTPS} !=on
#  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
#</IfModule>
